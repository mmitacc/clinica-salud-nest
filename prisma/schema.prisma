generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated-client"
}

datasource db {
  provider = "postgresql"
}

// Definicion de los 3 estados de: estado en 'cita'
enum EstadoCita {
  PROGRAMADA
  COMPLETADA
  CANCELADA
}

// Definicion de los 4 tipos de: 'role'
enum Role {
  RECEPCIONISTA
  MEDICO
  GERENCIA
  ADMIN
}

// Esquemas para la Base de datos

// ------------------- paciente ------------------ //
model Paciente {
  id              Int       @id @default(autoincrement())
  nombres         String    @db.VarChar(100)
  apellidos       String    @db.VarChar(100)
  telefono        String    @db.VarChar(20)
  email           String    @unique @db.VarChar(150)
  masculino       Boolean   @default(true)
  fechanacimiento DateTime  @db.Date
  tiposangre      String    @default("RHO+") @db.VarChar(5)
  alergias        String    @default("Ninguna") @db.Text
  registerdate    DateTime  @default(now())
  deleted         Boolean   @default(false)
  deletedate      DateTime? @db.Date

  // Relaciones inversas
  historiales Historial[]
  consultas   Consulta[]

  @@map("paciente")
}

// ------------------- historial ------------------ //
model Historial {
  id           Int       @id @default(autoincrement())
  id_paciente  Int
  motivo       String    @db.Text
  antecedentes String?   @db.Text
  triaje       String    @db.Text
  diagnostico  String?   @db.Text
  tratamiento  String?   @db.Text
  receta       String?   @db.Text
  registerdate DateTime  @default(now())
  deleted      Boolean   @default(false)
  deletedate   DateTime? @db.Date

  // Relación: Un historial pertenece a un paciente
  paciente Paciente @relation(fields: [id_paciente], references: [id], onDelete: Restrict)

  @@map("historial")
}

// ------------------- consulta ------------------ //
model Consulta {
  id           Int        @id @default(autoincrement())
  id_paciente  Int
  id_usuario   Int
  estado       EstadoCita @default(PROGRAMADA)
  citadate     DateTime   @db.Timestamp
  costo        Decimal    @default(50.0) @db.Decimal(10, 2)
  registerdate DateTime   @default(now())
  deleted      Boolean    @default(false)
  deletedate   DateTime?  @db.Date

  // Relaciones
  paciente Paciente @relation(fields: [id_paciente], references: [id], onDelete: Restrict)
  usuario  Usuario  @relation(fields: [id_usuario], references: [id], onDelete: Restrict)

  @@map("consulta")
}

// ------------------- usuario ------------------ //
model Usuario {
  id              Int       @id @default(autoincrement())
  id_especialidad Int?
  nombres         String    @db.VarChar(100)
  apellidos       String    @db.VarChar(100)
  telefono        String    @db.VarChar(20)
  masculino       Boolean   @default(true)
  fechanacimiento DateTime  @db.Date
  email           String    @unique @db.VarChar(150)
  password        String    @db.VarChar(100)
  role            Role
  username        String    @unique @db.VarChar(50)
  registerdate    DateTime  @default(now())
  deleted         Boolean   @default(false)
  deletedate      DateTime? @db.Date

  // Relaciones
  especialidad Especialidad? @relation(fields: [id_especialidad], references: [id], onDelete: Restrict)
  consultas    Consulta[]

  @@map("usuario")
}

// ------------------- especialidad ------------------ //
model Especialidad {
  id           Int       @id @default(autoincrement())
  tipo         String    @db.VarChar(100)
  registerdate DateTime  @default(now())
  deleted      Boolean   @default(false)
  deletedate   DateTime? @db.Date

  // Relaciones inversas
  usuarios Usuario[]

  @@map("especialidad")
}
